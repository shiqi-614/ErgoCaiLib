ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('GDEY0213B74 2.13in e-paper panel on the ErgoCai 2.13inch module, from its datasheet p7 drawing: 59.2 x 29.2 x 1.0 mm outline; protective sheet 56.85 x 28.20 (0.45 mm from the far end, 1.90 from the FPC end, 0.50 from the sides); active area 48.55 x 23.70, centred across, 7.95 mm from the FPC end; FPC 12.50 wide (14.43 near the panel), 14.30 long, 6.0 mm stiffener at its end, folded round the board notch into EP_FPC1 (the fold drawn as straight runs, shorter than the real bend). Boxes only. Origin: the board centre, z = 0 the board front.'),'2;1');
FILE_NAME('GDEY0213B74.step','2026-11-17T13:40:53',(''),(''),'box_step.py','',' ');
